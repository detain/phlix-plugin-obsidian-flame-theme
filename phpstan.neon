parameters:
    level: 9
    scanDirectories:
        - dev-stubs
    # The family reference corpus (phlix-plugin-sample-theme/phpstan.neon) is
    # src + tests, never just src. 5f5a803 narrowed this file to [src]; the
    # tests — including the 1,015-line SecurityAuditCheckTest that guards the
    # S440 gate, landed mid-window at 391dc1c — stayed unanalysed at level 9
    # until 9b7399e restored the corpus, 1,173 test lines measured at that
    # restore. scripts/ joins the corpus too: security-audit-check.php is the
    # code that DECIDES the audit verdict and must not be the least-checked
    # PHP in the repo. It analyses clean today; the paths entry is the
    # tripwire that keeps it that way.
    paths:
        - src
        - tests
        - scripts
    # No excludePaths for vendor: vendor is not inside any path above, so an
    # exclusion could only ever exclude nothing — the redundant line was dead
    # style-group noise (W-min141-obsidian item 06, srphp m6 parenthetical).
    # No ignoreErrors here, deliberately, and therefore no
    # reportUnmatchedIgnoredErrors either: the lone
    # '#Dynamic call to static method#' rule matched nothing under any corpus
    # (measured: level 9 over src+tests+scripts reports zero of them), and
    # reportUnmatchedIgnoredErrors: false is precisely the setting that made a
    # dead suppression permanent and undetectable. Re-add rules only against a
    # measured, attributed error.
    editorUrl: 'phpstorm://open?file=%%file%%&line=%%line%%'
